# Copy to .env and adjust. Never commit real values.

# --- API (Python / FastAPI) -------------------------------------------------

# Local development (SQLite file in the repo root):
DATABASE_URL=sqlite:///neobank.db
# Production (hosted PostgreSQL, e.g. Neon, Supabase, RDS). psycopg 3 driver:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/neobank?sslmode=require

# Required in production. Clients send it in the X-API-Key header.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Comma-separated browser origins allowed to call the API (your frontend's URL).
CORS_ORIGINS=http://localhost:5173

# Directory with trained model artifacts (*.joblib).
MODEL_DIR=models

# Set to false in production so the API never trains substitute models on the fly.
ALLOW_SYNTHETIC_MODELS=true

# Decision thresholds (fraud scores are probabilities in [0, 1]).
FRAUD_REVIEW_THRESHOLD=0.30
FRAUD_DECLINE_THRESHOLD=0.70
CREDIT_APPROVE_BELOW_PD=0.05
CREDIT_DECLINE_ABOVE_PD=0.15

# --- Frontend (Vite) --------------------------------------------------------
# Base URL of the deployed API. Leave empty to use the dev proxy on localhost:8000.
VITE_API_BASE=http://localhost:8000
